# Application & Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL Database (DBngin / Local default)
# For DBngin default: user 'postgres', no password, default db 'postgres' or 'ratchet_db'
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:@localhost:5432/postgres

# If using a custom DB created in DBngin:
# DATABASE_URL=postgresql://postgres:@localhost:5432/ratchet_db

# If using Docker Compose (docker compose up -d):
# DATABASE_URL=postgresql://ratchet:ratchet_password@localhost:5432/ratchet_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Worker & Engine Configuration
WORKER_CONCURRENCY=5
TASK_LEASE_DURATION_MS=30000
TIMER_POLL_INTERVAL_MS=1000

# AI Agent LLM Providers (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
